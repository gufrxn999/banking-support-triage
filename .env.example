# Copy to .env and adjust. All values have working defaults; nothing here is
# required for a local run.

# Where generated data, model artifacts, and reports live.
# TRIAGE_DATA_DIR=./data
# TRIAGE_ARTIFACTS_DIR=./artifacts
# TRIAGE_REPORTS_DIR=./reports

# Triage thresholds. Calibrated values are written to reports/m2_calibration.json;
# these defaults are placeholders until then.
# TRIAGE_AUTO_ROUTE_THRESHOLD=0.55
# TRIAGE_ESCALATE_THRESHOLD=0.40

# Exchange-rate tool
# FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
# FRANKFURTER_TIMEOUT_S=5
